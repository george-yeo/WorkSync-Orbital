# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB connection string (Atlas: Database > Connect > Drivers)
MONGO_URI=mongodb://127.0.0.1:27017/worksync

# >= 32 random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Comma-separated list of allowed browser origins (the client URL)
CLIENT_ORIGIN=http://localhost:5173

# Seed demo users/groups on boot if they don't exist, and allow "Try the demo" logins
DEMO_ENABLED=true
